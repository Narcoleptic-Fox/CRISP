{
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "tenantId",
    "ClientId": "clientId",
    "Domain": "https://clientId.onmicrosoft.com/",
    "Audience": "audienceId"
  },
  "AWS": {
    "Profile": "default",
    "Region": "us-east-1"
  },
  "RateLimiting": {
    "GlobalPermitLimitPerMinute": 50,
    "AuthenticatedPermitLimitPerMinute": 100,
    "AnonymousPermitLimitPerMinute": 20
  },
  "Email": {
    "Provider": "None",
    "From": "noreply@example.com"
  },
  "ObjectStorage": {
    "Provider": "None",
    "BucketName": "",
    "Region": "us-east-1",
    "DefaultPresignedUrlExpirationMinutes": 15
  },
  "Site": {
    "TimeZone": "America/New_York"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7299",
      "http://localhost:5045"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.*": "Warning",
      "Microsoft.AspNetCore.RateLimiting": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Error"
    }
  },
  "AllowedHosts": "*"
}
