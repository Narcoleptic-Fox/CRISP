# CRISP.Migrator settings. Copy to .env or .env.local next to this file (both are gitignored) or
# set them in the shell. Values here are examples, not defaults.

# --- Target database -------------------------------------------------------------------------
# Either give the whole connection string (${NAME} tokens expand from environment variables)...
# ConnectionStrings__default="Host=127.0.0.1;Port=5432;Database=crisp;Username=postgres;Password=password;"
# ...or the parts, and the Migrator assembles it:
DATABASE_HOST="127.0.0.1"
DATABASE_PORT="5432"
DATABASE_NAME="crisp"
DATABASE_USER="postgres"
DATABASE_PASSWORD="password"

# --- Optional SSH bastion ---------------------------------------------------------------------
# When BASTION_HOST is set the Migrator opens an SSH tunnel and reaches DATABASE_HOST:DATABASE_PORT
# through it on LOCAL_FORWARD_PORT. Leave unset to connect directly (local development, CI).
# BASTION_HOST="bastion.example.com"
# BASTION_USERNAME="ec2-user"
# BASTION_KEY_PATH="C:/Users/me/.ssh/bastion.pem"
# LOCAL_FORWARD_PORT="33700"
