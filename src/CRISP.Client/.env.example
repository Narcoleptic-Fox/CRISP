# CRISP environment variables. Copy to .env (or set in your shell / launchSettings) and edit as needed.
# Vite reads .env files from src/CRISP.Client/. 

# Port the SPA dev server listens on. Must match the SPA redirect URI registered in Entra.
DEV_SERVER_PORT=5000

# Target backend URL the dev server proxies /api/* to.
# Either ASPNETCORE_HTTPS_PORT or ASPNETCORE_URLS is honored; otherwise proxy defaults to https://localhost:7084.
ASPNETCORE_HTTPS_PORT=7084
# ASPNETCORE_URLS=https://localhost:7084;http://localhost:5149

# MSAL redirect URI. A path (e.g. "signin-oidc" or "/signin-oidc") joined to the
# running site origin, or a full absolute URL used verbatim. Must EXACTLY match a
# redirect URI registered on the Entra app registration by Siemens IT (some apps
# use /signin-oidc, others the site root). Unset/empty defaults to the site root "/".
# Build-time only: Vite inlines this at `npm run build`, so it must be present then
# (committed .env.production or a Docker build ARG) — .env.local is NOT in the image build.
VITE_REDIRECT_URI=signin-oidc