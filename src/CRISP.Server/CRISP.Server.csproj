<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<UserSecretsId>4cc26860-8c1d-49a3-98fd-37ebc28327e0</UserSecretsId>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>

		<!-- The SPA is served by Vite in development (SpaProxy) and copied into wwwroot/ by the
		     Dockerfile in deployment. This project owns no static web assets of its own, and with the
		     feature on, the generated manifest makes startup require a wwwroot/ directory that does not
		     exist in a fresh checkout. -->
		<StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>

<!--#if (IncludeReact)-->
		<SpaRoot>..\CRISP.Client</SpaRoot>
		<SpaProxyLaunchCommand>npm run dev</SpaProxyLaunchCommand>
		<SpaProxyServerUrl>https://localhost:58733</SpaProxyServerUrl>
<!--#endif-->

	</PropertyGroup>

	<ItemGroup Label="ASP.NET Core">
		<PackageReference Include="Asp.Versioning.Http" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" />
<!--#if (IncludeReact)-->
		<PackageReference Include="Microsoft.AspNetCore.SpaProxy" />
<!--#endif-->
		<PackageReference Include="Microsoft.Extensions.Http.Resilience" />
		<PackageReference Include="Microsoft.Extensions.ServiceDiscovery" />
		<PackageReference Include="Microsoft.Identity.Web" />
		<PackageReference Include="Microsoft.Identity.Web.DownstreamApi" />
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" />
	</ItemGroup>

	<ItemGroup Label="Entity Framework Core">
		<PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
<!--#if (UseMySql)-->
		<PackageReference Include="Microting.EntityFrameworkCore.MySql" />
<!--#endif-->
<!--#if (UsePostgres)-->
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
<!--#endif-->
<!--#if (UseSqlServer)-->
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
<!--#endif-->
<!--#if (UseSqlite)-->
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
<!--#endif-->
	</ItemGroup>

	<ItemGroup Label="Third-Party">
		<PackageReference Include="AWSSDK.S3" />
		<PackageReference Include="AWSSDK.SimpleEmailV2" />
		<PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
		<PackageReference Include="MimeTypes">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
<!--#if (IncludeReact)-->
		<ProjectReference Include="..\CRISP.Client\CRISP.Client.esproj">
			<ReferenceOutputAssembly>false</ReferenceOutputAssembly>
		</ProjectReference>
<!--#endif-->
		<ProjectReference Include="..\CRISP.Core\CRISP.Core.csproj" />
<!--#if (UseAspire)-->
		<ProjectReference Include="..\CRISP.ServiceDefaults\CRISP.ServiceDefaults.csproj" />
<!--#endif-->
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="CRISP.Server.Tests" />
	</ItemGroup>

<!--#if (IsTemplateRepository)-->
	<!-- One DatabaseProvider is compiled per solution. The template repository builds as PostgreSQL and
	     keeps the other providers' sources out of this compilation; a generated solution receives
	     only the folder for its database choice, so these lines are stripped from it. -->
	<ItemGroup>
		<Compile Remove="Data\Providers\MySql\**;Data\Providers\SqlServer\**;Data\Providers\Sqlite\**" />
	</ItemGroup>
<!--#endif-->
</Project>