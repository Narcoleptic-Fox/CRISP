<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Packs this repository as the `dotnet new crisp` template. The repository root IS the template
    content: there is no mirrored copy under templates/ to drift from the code that is built and
    tested here. .template.config/template.json decides what is excluded and what is conditional.
  -->
  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>CRISP</PackageId>
    <Title>CRISP - vertical-slice CQRS web application template</Title>
    <Version>3.0.0</Version>
    <Authors>Narcoleptic Fox LLC</Authors>
    <Company>Narcoleptic Fox LLC</Company>
    <Description>ASP.NET Core minimal-API server with explicit command/query contracts and direct service injection, EF Core on PostgreSQL, MySQL, SQL Server or SQLite with an out-of-band Migrator, optional Entra JWT + API-key authentication, an optional Aspire AppHost, an in-process event bus, presigned-URL object storage, and a React + Vite client typed from Core. Ships a worked Item slice to copy.</Description>
    <PackageTags>dotnet-new;templates;cqrs;vertical-slice;minimal-api;react;aspire;postgresql;mysql;sqlserver;sqlite</PackageTags>
    <PackageProjectUrl>https://github.com/Narcoleptic-Fox/CRISP</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Narcoleptic-Fox/CRISP</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <EnableDefaultItems>false</EnableDefaultItems>
    <!-- This project is packaging, not code: keep the shared build properties from treating it as a library. -->
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="**\*"
             Exclude="$(MSBuildProjectFile);tests\CRISP.Template.Tests\**;.github\workflows\ci-template.yml;.github\workflows\docs.yml;.git\**;.local\**;.claude\settings.local.json;docs\design\2026-*.md;site\**;.nav-generated.json;NuGet.Config;nuget.config;TestResults\**;artifacts\**;**\bin\**;**\obj\**;**\node_modules\**;**\dist\**;**\.vs\**;**\*.user;**\.env;**\.env.local;src\CRISP.Client\src\api\**;*.nupkg" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
