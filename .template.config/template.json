{
  "$schema": "http://json.schemastore.org/template",
  "author": "Narcoleptic Fox LLC",
  "classifications": [
    "Web",
    "API",
    "CQRS",
    "Vertical Slice",
    "React",
    "Aspire"
  ],
  "identity": "NarcolepticFox.CRISP",
  "groupIdentity": "NarcolepticFox.CRISP",
  "name": "CRISP - vertical-slice CQRS web application",
  "description": "ASP.NET Core minimal-API server with explicit command/query contracts and direct service injection (no mediator), EF Core on PostgreSQL, MySQL, SQL Server or SQLite with an out-of-band Migrator, optional Entra JWT + API-key authentication, an optional Aspire AppHost, an in-process event bus, presigned-URL object storage, and a React + Vite client consuming TypeGen-generated contracts. Ships a worked Item slice to copy.",
  "shortName": "crisp",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sourceName": "CRISP",
  "preferNameDirectory": true,
  "symbols": {
    "Frontend": {
      "type": "parameter",
      "description": "The client to include.",
      "datatype": "choice",
      "choices": [
        {
          "choice": "react",
          "description": "React 19 + Vite + Tailwind 4 + shadcn, typed from Core via TypeGen"
        },
        {
          "choice": "none",
          "description": "No client (API only)"
        }
      ],
      "defaultValue": "react"
    },
    "IncludeReact": {
      "type": "computed",
      "value": "(Frontend == \"react\")"
    },
    "IncludeSample": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Include the worked Item slice (contracts, entity, endpoints, client pages, tests). Without it the solution has no domain feature and no migration yet: run `dotnet ef migrations add InitialCreate --project src/CRISP.Server` after adding your first entity."
    },
    "Database": {
      "type": "parameter",
      "description": "The relational database provider.",
      "datatype": "choice",
      "choices": [
        {
          "choice": "mysql",
          "description": "MySQL 8.4 (Microting.EntityFrameworkCore.MySql). Migration generated on first use."
        },
        {
          "choice": "postgres",
          "description": "PostgreSQL 16 (Npgsql). Ships with the InitialCreate migration."
        },
        {
          "choice": "sqlserver",
          "description": "SQL Server 2022. Migration generated on first use."
        },
        {
          "choice": "sqlite",
          "description": "SQLite file database. No container; integration tests recreate the file."
        }
      ],
      "defaultValue": "postgres"
    },
    "UseMySql": {
      "type": "computed",
      "value": "(Database == \"mysql\")"
    },
    "UsePostgres": {
      "type": "computed",
      "value": "(Database == \"postgres\")"
    },
    "UseSqlServer": {
      "type": "computed",
      "value": "(Database == \"sqlserver\")"
    },
    "UseSqlite": {
      "type": "computed",
      "value": "(Database == \"sqlite\")"
    },
    "Auth": {
      "type": "parameter",
      "description": "Authentication and authorization.",
      "datatype": "choice",
      "choices": [
        {
          "choice": "entra",
          "description": "Entra ID JWT bearer + API key, Viewer/Editor/Admin roles from the Users table, MSAL in the client"
        },
        {
          "choice": "none",
          "description": "No authentication: every endpoint is anonymous, no Users or ApiKeys, no sign-in in the client. For internal tools and prototypes."
        }
      ],
      "defaultValue": "entra"
    },
    "IncludeAuth": {
      "type": "computed",
      "value": "(Auth == \"entra\")"
    },
    "UseAspire": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Add a .NET Aspire AppHost that runs the database container, the server and the client together, plus ServiceDefaults for telemetry and health."
    },
    "IsTemplateRepository": {
      "type": "computed",
      "value": "false",
      "description": "Always false in generated output: guards the parts of the solution that only make sense in the template repository itself."
    },
    "skipRestore": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Skip the automatic restore of the project on create."
    }
  },
